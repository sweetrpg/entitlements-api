{
    "swagger": "2.0",
    "info": {
        "description": "Swagger APIs",
        "title": "Entitlements API service",
        "termsOfService": "https://pilgrimagesoftware.com/terms/",
        "contact": {
            "name": "API Support",
            "url": "https://sweetrpg.com",
            "email": "admin@sweetrpg.com"
        },
        "license": {
            "name": "MIT",
            "url": "https://mit-license.org/"
        },
        "version": "1.0"
    },
    "paths": {
        "/billing/checkout": {
            "post": {
                "description": "Returns a Stripe-hosted checkout URL, or switches the caller's existing subscription in the product's plan group. A switch needs confirm=true: without it the response is 409 confirmation_required carrying a quote to show the user; an upgrade is charged immediately and a failed payment is 402 payment_failed with nothing changed.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "billing"
                ],
                "summary": "Start a checkout or switch a plan",
                "parameters": [
                    {
                        "description": "tier_id or product_id (+ quantity, confirm, proration_date)",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/server.checkoutBody"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/server.SessionVO"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/vo.ErrorVO"
                        }
                    },
                    "402": {
                        "description": "Payment Required",
                        "schema": {
                            "$ref": "#/definitions/vo.ErrorVO"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/server.ConfirmationRequiredVO"
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "$ref": "#/definitions/vo.ErrorVO"
                        }
                    }
                }
            }
        },
        "/billing/portal": {
            "post": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "billing"
                ],
                "summary": "Open the billing portal",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/server.SessionVO"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/vo.ErrorVO"
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "$ref": "#/definitions/vo.ErrorVO"
                        }
                    }
                }
            }
        },
        "/billing/quote": {
            "get": {
                "description": "What POST /billing/checkout would do and what it would cost, changing nothing. action is checkout, switch, or none. Amounts are minor units (cents). For a switch the figure comes from Stripe's invoice preview with the same proration the real switch uses; send proration_date back with confirm so the charge matches.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "billing"
                ],
                "summary": "Quote a purchase or plan change",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Product to buy or switch to",
                        "name": "product_id",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Quantity (default 1)",
                        "name": "quantity",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/billing.Quote"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/vo.ErrorVO"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/vo.ErrorVO"
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "$ref": "#/definitions/vo.ErrorVO"
                        }
                    }
                }
            }
        },
        "/check": {
            "get": {
                "description": "Effective value for one key for the verified caller. Cacheable for ttl_seconds.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "check"
                ],
                "summary": "Check one key",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Entitlement key, e.g. initiative.theme_slots",
                        "name": "key",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/server.CheckVO"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/vo.ErrorVO"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/vo.ErrorVO"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/vo.ErrorVO"
                        }
                    }
                }
            }
        },
        "/check/batch": {
            "get": {
                "description": "Exactly one of repeated key params or a prefix. An unknown key fails the whole batch with 404.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "check"
                ],
                "summary": "Check several keys",
                "parameters": [
                    {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "collectionFormat": "multi",
                        "description": "Entitlement key; repeat for several (max 200)",
                        "name": "key",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Key prefix, e.g. initiative. (max 128 characters)",
                        "name": "prefix",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/server.BatchCheckVO"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/vo.ErrorVO"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/vo.ErrorVO"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/vo.ErrorVO"
                        }
                    }
                }
            }
        },
        "/status/health": {
            "get": {
                "description": "Health check",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "status"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/vo.HealthResponseVO"
                        }
                    }
                }
            }
        },
        "/status/ping": {
            "get": {
                "description": "Ping",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "status"
                ],
                "summary": "Ping",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/vo.PingResponseVO"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "billing.Quote": {
            "type": "object",
            "properties": {
                "action": {
                    "type": "string"
                },
                "amount_due_now": {
                    "description": "AmountDueNow is what is charged when the user goes ahead: price x quantity for a checkout, the\nprorated difference for an upgrade, and 0 for a downgrade.",
                    "type": "integer"
                },
                "credit_on_next_invoice": {
                    "description": "CreditOnNextInvoice is the credit a downgrade earns against the next invoice.",
                    "type": "integer"
                },
                "currency": {
                    "type": "string"
                },
                "current_product": {
                    "$ref": "#/definitions/billing.QuoteProduct"
                },
                "new_product": {
                    "$ref": "#/definitions/billing.QuoteProduct"
                },
                "next_billing_date": {
                    "description": "NextBillingDate is when the subscription renews next; empty for a one-off purchase.",
                    "type": "string"
                },
                "proration_date": {
                    "description": "ProrationDate pins the proration to the moment of the quote. Send it back with confirm so the\ncharge matches the figure shown; omit it and Stripe prorates at the time of the request.",
                    "type": "integer"
                },
                "proration_lines": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/billing.QuoteLine"
                    }
                },
                "quantity": {
                    "type": "integer"
                }
            }
        },
        "billing.QuoteLine": {
            "type": "object",
            "properties": {
                "amount": {
                    "description": "minor units; negative is a credit",
                    "type": "integer"
                },
                "description": {
                    "type": "string"
                }
            }
        },
        "billing.QuoteProduct": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "models.KeyType": {
            "type": "string",
            "enum": [
                "flag",
                "limit"
            ],
            "x-enum-varnames": [
                "TypeFlag",
                "TypeLimit"
            ]
        },
        "server.BatchCheckVO": {
            "type": "object",
            "properties": {
                "results": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/server.CheckVO"
                    }
                }
            }
        },
        "server.CheckVO": {
            "type": "object",
            "properties": {
                "key": {
                    "type": "string"
                },
                "ttl_seconds": {
                    "type": "integer"
                },
                "type": {
                    "$ref": "#/definitions/models.KeyType"
                },
                "value": {}
            }
        },
        "server.ConfirmationRequiredVO": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                },
                "quote": {
                    "$ref": "#/definitions/billing.Quote"
                }
            }
        },
        "server.SessionVO": {
            "type": "object",
            "properties": {
                "switched": {
                    "type": "boolean"
                },
                "url": {
                    "type": "string"
                }
            }
        },
        "server.checkoutBody": {
            "type": "object",
            "properties": {
                "confirm": {
                    "description": "Confirm is the user's go-ahead to switch their subscription to another plan in the same\ngroup. Without it a switch is answered with 409 confirmation_required and the quote.",
                    "type": "boolean"
                },
                "product_id": {
                    "type": "string"
                },
                "proration_date": {
                    "description": "ProrationDate is the proration_date from the quote being confirmed.",
                    "type": "integer"
                },
                "quantity": {
                    "type": "integer"
                },
                "tier_id": {
                    "type": "string"
                }
            }
        },
        "vo.ErrorVO": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "vo.HealthResponseVO": {
            "type": "object",
            "properties": {
                "collections": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "database": {
                    "type": "string"
                },
                "errors": {
                    "type": "integer"
                },
                "messages": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "ping": {
                    "type": "string"
                }
            }
        },
        "vo.PingResponseVO": {
            "type": "object",
            "properties": {
                "date": {
                    "type": "string"
                },
                "hostname": {
                    "type": "string"
                }
            }
        }
    }
}