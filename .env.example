# Database (mongodb.go): either DB_URI, or the individual parts.
DB_URI=mongodb://localhost:27017/entitlements-api

# auth-api verifies admin bearer tokens; users-api resolves the admin's canonical user ID.
AUTH_API_URL=http://localhost:8001
USERS_API_URL=http://localhost:8002

# Registered services allowed to call /check, as name=token pairs (tokens 32+ characters).
SERVICE_TOKENS=initiative-api=replace-with-a-long-random-token-value

ALLOWED_ORIGINS=
BIND_ADDRESS=:8000
REDIS_HOST=
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
PYROSCOPE_SERVER_ADDRESS=
